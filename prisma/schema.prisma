generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==========================================
// [TENANT & AUTH]
// ==========================================

model Tenant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  slug      String   @unique
  plan  Plan     @default(FREE)
  logo      String?
  settings  Json?    
  notifications Notification[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  roles          Role[]
  employees      Employee[]
  departments    Department[]
  designations   Designation[]
  leaveTypes     LeaveType[]
  contacts       Contact[]
  leads          Lead[]
  pipelines      Pipeline[]
  activities     Activity[]
  deals          Deal[]
  products       Product[]
  categories     Category[]
  warehouses     Warehouse[]
  stocks         Stock[]
  stockMovements StockMovement[]
  accounts       Account[]
  transactions   Transaction[]
  journalEntries JournalEntry[]
  invoices       Invoice[]
  payments       Payment[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]
  vendors        Vendor[]
  purchaseOrders PurchaseOrder[]
  grns           GRN[]
  boms           BOM[]
  workOrders     WorkOrder[]
  projects       Project[]
  aiQueries      AIQuery[]
  aiInsights     AIInsight[]
  automations    Automation[]
  auditLogs      AuditLog[]


}

enum Plan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String    @db.ObjectId
  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String?
  email         String?   @unique
  password  String?
  role          UserRole  @default(USER)
  avatar        String?
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  notifications Notification[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  AccountAuth[]
  sessions  Session[]
  auditLogs AuditLog[]
  aiQueries AIQuery[]
  timeLogs  TimeLog[]
  employee  Employee?     @relation("UserToEmployee", fields: [employeeId], references: [id])
  employeeId String? @db.ObjectId @unique

  @@index([tenantId, email])
}

enum UserRole {
  ADMIN
  MANAGER
  USER
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  permissions Json?    
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken  String   @unique
  userId  String   @db.ObjectId
  expires  DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user  User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  module    String
  action    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId, module, action])
}

// ==========================================
// [HRM MODULE]
// ==========================================

model Employee {
  id  String  @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String    @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId    String   
  name          String
  email         String?
  phone         String?
  dob           DateTime?
  gender        String?
  employmentType String? @default("Full-time")
  departmentId  String? @db.ObjectId
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  designationId String? @db.ObjectId
  designation  Designation? @relation(fields: [designationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  joiningDate   DateTime
  salary        Float
  status        EmployeeStatus @default(ACTIVE)
  role          UserRole       @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?    @relation("UserToEmployee")
  attendances   Attendance[]
  leaves        Leave[]
  payrolls      Payroll[]

  @@unique([tenantId, employeeId])
  @@index([tenantId, departmentId])
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  ON_LEAVE
}

model Department {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  managerId String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees    Employee[]
  designations Designation[]

  @@unique([tenantId, name])
}

model Designation {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  departmentId String? @db.ObjectId
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employees Employee[]

  @@unique([tenantId, name])
}

model Attendance {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId  String   @db.ObjectId
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  note       String?

  @@unique([employeeId, date])
  @@index([date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALFDAY
}

model Leave {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId  String   @db.ObjectId
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  typeId     String   @db.ObjectId
  type  LeaveType @relation(fields: [typeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  from       DateTime
  to         DateTime
  status     LeaveStatus @default(PENDING)
  reason     String?
  createdAt  DateTime @default(now())

  @@index([employeeId, status])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  daysAllowed Int
  createdAt   DateTime @default(now())

  leaves Leave[]

  @@unique([tenantId, name])
}

model Payroll {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId  String @db.ObjectId
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month       Int
  year        Int
  basic       Float
  allowances  Float @default(0)
  deductions  Float @default(0)
  netPay      Float
  status      PayrollStatus @default(DRAFT)
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([employeeId, year, month])
}

enum PayrollStatus {
  DRAFT
  PAID
  CANCELLED
}

// ==========================================
// [CRM MODULE]
// ==========================================

model Contact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  company   String?
  type      ContactType @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads      Lead[]
  activities Activity[]
  quotations Quotation[]
  salesOrders SalesOrder[]
  invoices   Invoice[]

  @@index([tenantId, email])
}

enum ContactType {
  CUSTOMER
  PROSPECT
  PARTNER
}

model Lead {
  id  String  @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String    @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title         String
  value         Float?
  stage         String
  assignedTo    String?  
  expectedClose DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deals      Deal[]
  activities Activity[]

  @@index([tenantId, stage])
}

model Pipeline {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  stages    Json?    
  createdAt DateTime @default(now())

  @@unique([tenantId, name])
}

model Activity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      ActivityType
  subject   String
  contactId String? @db.ObjectId
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leadId    String? @db.ObjectId
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dueDate   DateTime?
  status    ActivityStatus @default(TODO)
  createdAt DateTime @default(now())

  @@index([tenantId, status, dueDate])
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  TASK
}

enum ActivityStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Deal {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId    String   @db.ObjectId
  lead  Lead     @relation(fields: [leadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  value     Float
  status    DealStatus @default(OPEN)
  closedAt  DateTime?
  createdAt DateTime @default(now())

  @@index([tenantId, status])
}

enum DealStatus {
  OPEN
  WON
  LOST
}

// ==========================================
// [INVENTORY MODULE]
// ==========================================

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku         String
  name        String
  categoryId  String?  @db.ObjectId
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit        String
  costPrice   Float
  salePrice   Float
  minStock    Int      @default(0)
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stocks      Stock[]
  movements   StockMovement[]
  invoiceItems InvoiceItem[]
  orderItems  OrderItem[]
  poItems     POItem[]
  grnItems    GRNItem[]
  boms        BOM[]
  bomItems    BOMItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Category[] @relation("CategoryHierarchy")
  createdAt DateTime @default(now())

  products Product[]

  @@unique([tenantId, name])
}

model Warehouse {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  location  String?
  manager   String?
  createdAt DateTime @default(now())

  stocks    Stock[]
  movements StockMovement[]

  @@unique([tenantId, name])
}

model Stock {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String   @db.ObjectId
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String   @db.ObjectId
  warehouse  Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int      @default(0)
  reservedQty Int      @default(0)

  @@unique([productId, warehouseId])
}

model StockMovement {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String   @db.ObjectId
  product  Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouseId String   @db.ObjectId
  warehouse  Warehouse @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type        MovementType
  quantity    Int
  reference   String?  
  note        String?
  createdAt   DateTime @default(now())

  @@index([tenantId, productId, type])
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

// ==========================================
// [FINANCE MODULE]
// ==========================================

model Account {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String   
  name      String
  type      AccountType
  parentId  String?
  parent    Account? @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Account[] @relation("AccountHierarchy")
  balance   Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  journalLines JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Transaction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date        DateTime
  reference   String?
  description String?
  type        TransactionType
  amount      Float
  accountId   String   @db.ObjectId
  account  Account  @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime @default(now())

  @@index([tenantId, date, type])
}

enum TransactionType {
  DEBIT
  CREDIT
}

model JournalEntry {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date        DateTime
  reference   String?
  description String?
  createdAt   DateTime @default(now())

  lines JournalLine[]

  @@index([tenantId, date])
}

model JournalLine {
  id  String  @id @default(auto()) @map("_id") @db.ObjectId
  journalId      String @db.ObjectId
  journalEntry   JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId      String @db.ObjectId
  account        Account      @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  debit          Float @default(0)
  credit         Float @default(0)
}

model Invoice {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number    String   @unique
  contactId  String   @db.ObjectId
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date      DateTime
  dueDate   DateTime
  status    InvoiceStatus @default(DRAFT)
  subtotal  Float
  tax       Float @default(0)
  total     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([tenantId, status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId  String @db.ObjectId
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String? @db.ObjectId
  product     Product? @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description String
  qty         Int
  price       Float
  total       Float
}

model Payment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId String? @db.ObjectId
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date      DateTime
  amount    Float
  method    String
  createdAt DateTime @default(now())

  @@index([tenantId, date])
}

// ==========================================
// [SALES MODULE]
// ==========================================

model Quotation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number    String   @unique
  contactId  String   @db.ObjectId
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date      DateTime
  validTill DateTime
  status    QuotationStatus @default(DRAFT)
  total     Float
  createdAt DateTime @default(now())

  salesOrders SalesOrder[]

  @@index([tenantId, status])
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model SalesOrder {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotationId String? @db.ObjectId
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  number      String   @unique
  contactId  String @db.ObjectId
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date        DateTime
  status      SalesOrderStatus @default(OPEN)
  total       Float
  createdAt   DateTime @default(now())

  items OrderItem[]

  @@index([tenantId, status])
}

enum SalesOrderStatus {
  OPEN
  SHIPPED
  COMPLETED
  CANCELLED
}

model OrderItem {
  id  String  @id @default(auto()) @map("_id") @db.ObjectId
  salesOrderId String @db.ObjectId
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String @db.ObjectId
  product      Product    @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  qty          Int
  price        Float
  total        Float
}

// ==========================================
// [PROCUREMENT MODULE]
// ==========================================

model Vendor {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  address   String?
  rating    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, name])
}

model PurchaseOrder {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorId  String   @db.ObjectId
  vendor  Vendor   @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  number    String   @unique
  date  DateTime
  status    POStatus @default(DRAFT)
  total     Float
  createdAt DateTime @default(now())

  items POItem[]
  grns  GRN[]

  @@index([tenantId, status])
}

enum POStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model POItem {
  id  String  @id @default(auto()) @map("_id") @db.ObjectId
  purchaseOrderId String @db.ObjectId
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String @db.ObjectId
  product         Product       @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  qty             Int
  price           Float
  total           Float
}

model GRN {
  id  String  @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String @db.ObjectId
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrderId String @db.ObjectId
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date            DateTime
  status          GRNStatus     @default(PENDING)
  note            String?
  createdAt       DateTime      @default(now())

  items GRNItem[]

  @@index([tenantId, status])
}

enum GRNStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model GRNItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  grnId  String @db.ObjectId
  grn         GRN      @relation(fields: [grnId], references: [id], onDelete: Cascade)
  productId   String   @db.ObjectId
  product  Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receivedQty Int
}

// ==========================================
// [MANUFACTURING MODULE]
// ==========================================

model BOM {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String   @db.ObjectId
  product  Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name        String
  version     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  items      BOMItem[]
  workOrders WorkOrder[]

  @@index([tenantId, productId])
}

model BOMItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  bomId  String   @db.ObjectId
  bom  BOM      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  materialId String   @db.ObjectId
  material  Product  @relation(fields: [materialId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity   Float
  unit       String
}

model WorkOrder {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bomId     String @db.ObjectId
  bom       BOM      @relation(fields: [bomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity  Int
  startDate DateTime
  endDate   DateTime?
  status    WOStatus @default(PLANNED)
  createdAt DateTime @default(now())

  logs ProductionLog[]

  @@index([tenantId, status])
}

enum WOStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ProductionLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workOrderId  String   @db.ObjectId
  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  date        DateTime
  produced    Int
  waste       Int      @default(0)
  note        String?
}

// ==========================================
// [PROJECTS MODULE]
// ==========================================

model Project {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  client    String?
  startDate DateTime
  endDate   DateTime?
  budget    Float?
  status    ProjectStatus @default(NOT_STARTED)
  managerId String? @db.ObjectId 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks      Task[]
  milestones Milestone[]

  @@index([tenantId, status])
}

enum ProjectStatus {
  NOT_STARTED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Task {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId  String   @db.ObjectId
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  assignedTo  String? @db.ObjectId 
  priority    Priority @default(MEDIUM)
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  timeLogs TimeLog[]

  @@index([projectId, status])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model TimeLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId  String   @db.ObjectId
  task  Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date        DateTime
  hours       Float
  description String?
  createdAt   DateTime @default(now())
}

model Milestone {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId  String   @db.ObjectId
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime
  isCompleted Boolean  @default(false)
}

// ==========================================
// [AI MODULE]
// ==========================================

model AIQuery {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user  User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  query     String   
  response  String   
  module    String
  createdAt DateTime @default(now())

  @@index([tenantId, userId, module])
}

model AIInsight {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String   
  title       String
  description String   
  data        Json?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([tenantId, isRead])
}

model Automation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String @db.ObjectId
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  trigger    String   
  conditions Json?
  actions    Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([tenantId, isActive])
}

// ==========================================
// [NEXT-AUTH MODELS]
// ==========================================

model AccountAuth {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId  String   @db.ObjectId
  type  String
  provider          String
  providerAccountId String
  refresh_token     String? 
  access_token      String? 
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? 
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier  String
  token      String   @unique
  expires  DateTime

  @@unique([identifier, token])
}

model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String   @db.ObjectId
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?  @db.ObjectId
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  type        String   @default("info") // info, success, warning, error
  category    String   @default("System")
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, userId, isRead])
}

